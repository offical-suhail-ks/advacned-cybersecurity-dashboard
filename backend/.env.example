# Application Settings
APP_NAME=CyberSecurity Dashboard API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/cybersec_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT Authentication
SECRET_KEY=847bbb1fc578f4175f01198ac83ee8d4
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
ELASTICSEARCH_INDEX_PREFIX=cybersec

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload Settings
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_FILE_EXTENSIONS=.exe,.dll,.pdf,.doc,.docx,.zip,.rar

# OWASP ZAP Configuration
ZAP_API_KEY=your-zap-api-key
ZAP_PROXY_URL=http://localhost:8080

# VirusTotal API
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# NVD API (CVE Database)
NVD_API_KEY=your-nvd-api-key

# Email Configuration (for SOAR alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=security-alerts@yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security Headers
SECURITY_HEADERS_ENABLED=True

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30

# AI Model Settings
ANOMALY_DETECTION_THRESHOLD=0.1
MODEL_TRAINING_INTERVAL_HOURS=24

# Threat Intelligence
THREAT_INTEL_UPDATE_INTERVAL_HOURS=6

# MITRE ATT&CK
MITRE_ATTACK_VERSION=v13

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
